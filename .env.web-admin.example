DB_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_SHOW_SQL=false
REDIS_PASSWORD=change-me-redis-password
MINIO_ACCESS_KEY=lease-minio-admin
MINIO_SECRET_KEY=change-me-minio-secret-min-8-chars
MINIO_BUCKET_NAME=lease-bucket
# Use http://minio:9000 for backend-only access. Use a public HTTPS URL if returned upload URLs must open in browsers.
MINIO_ENDPOINT=http://minio:9000
JWT_SECRET=change-me-to-at-least-32-random-characters

# Keep 127.0.0.1 when Nginx is on the same server.
# Use 0.0.0.0 only when another server must reach this backend, then restrict access with firewall rules.
WEB_ADMIN_BIND=127.0.0.1
MINIO_API_BIND=127.0.0.1
MINIO_CONSOLE_BIND=127.0.0.1
